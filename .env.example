# Copy to .env for local experiments. Never commit .env.
# Production values come from Azure Key Vault; see infra/bicep and docs/azure-deployment.md.

ACN_ENV=local
ACN_TOKEN_SALT=local-dev-salt-not-for-production
ACN_AS_OF=2026-11-01

# Event Hubs Kafka endpoint (Azure-only execution path)
EVENT_HUBS_BOOTSTRAP=
EVENT_HUBS_CONNECTION_STRING=
EVENT_HUB_NAME=clinical-ingress

# ADLS Gen2
AZURE_STORAGE_ACCOUNT=
ADLS_CONTAINER=clinical

# Databricks Asset Bundles / ADF
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_CLUSTER_ID=

# Azure identity for the CD workflow
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=rg-acn-alderbrook

KEY_VAULT_URI=
APPLICATIONINSIGHTS_CONNECTION_STRING=
