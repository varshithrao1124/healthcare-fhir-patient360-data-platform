{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alderbrook.example/contracts/envelope.schema.json",
  "title": "Northline clinical ingress envelope",
  "type": "object",
  "required": ["event_id", "source_system", "payload_type", "event_time", "body"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "source_system": {"type": "string", "enum": ["AMC", "RGH", "CHO"]},
    "payload_type": {"type": "string", "enum": ["HL7_V2", "FHIR_R4", "FHIR_BULK"]},
    "event_time": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"},
    "partition": {"type": "integer", "minimum": 0},
    "offset": {"type": "integer", "minimum": 0},
    "body": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
