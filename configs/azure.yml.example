# Example settings for a Databricks job. Paths and secrets are references, not values.
environment: azure
as_of: "2026-11-01"
allowed_lateness_hours: 2
transport: kafka
catalog: acn_prod
token_salt_env: ACN_TOKEN_SALT
lake_uri: abfss://clinical@${AZURE_STORAGE_ACCOUNT}.dfs.core.windows.net/northline
checkpoint_uri: abfss://clinical@${AZURE_STORAGE_ACCOUNT}.dfs.core.windows.net/checkpoints/capture
event_hub:
  bootstrap_env: EVENT_HUBS_BOOTSTRAP
  connection_env: EVENT_HUBS_CONNECTION_STRING
  topic_env: EVENT_HUB_NAME
schemas:
  capture: capture
  restricted: restricted
  insight: insight
  deidentified: deidentified
  assure: assure
mpi:
  auto_threshold: 0.86
  review_threshold: 0.70
